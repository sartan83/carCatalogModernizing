@page
@model CreateModel
@{
    ViewData["Title"] = "Create";
}

<h2 class="esh-body-title">Create</h2>

<div>
    <form method="post" class="form-horizontal">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group">
            <label class="control-label col-md-2" asp-for="Product.Name">Name</label>
            <div class="col-md-3">
                <input asp-for="Product.Name" class="form-control" />
                <span asp-validation-for="Product.Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" asp-for="Product.Description">Description</label>
            <div class="col-md-3">
                <input asp-for="Product.Description" class="form-control" />
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" asp-for="Product.CatalogBrandId">Brand</label>
            <div class="col-md-3">
                <select asp-for="Product.CatalogBrandId" asp-items="Model.Brands" class="form-control"></select>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" asp-for="Product.CatalogTypeId">Type</label>
            <div class="col-md-3">
                <select asp-for="Product.CatalogTypeId" asp-items="Model.Types" class="form-control"></select>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" asp-for="Product.Price">Price</label>
            <div class="col-md-3">
                <input asp-for="Product.Price" class="form-control" />
                <span asp-validation-for="Product.Price" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2">Picture name</label>
            <div class="col-md-4 esh-form-information">
                Uploading images not allowed for this version.
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" asp-for="Product.AvailableStock">Stock</label>
            <div class="col-md-3">
                <input asp-for="Product.AvailableStock" class="form-control" />
                <span asp-validation-for="Product.AvailableStock" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" asp-for="Product.RestockThreshold">Restock</label>
            <div class="col-md-3">
                <input asp-for="Product.RestockThreshold" class="form-control" />
                <span asp-validation-for="Product.RestockThreshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label class="control-label col-md-2" asp-for="Product.MaxStockThreshold">Max stock</label>
            <div class="col-md-3">
                <input asp-for="Product.MaxStockThreshold" class="form-control" />
                <span asp-validation-for="Product.MaxStockThreshold" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-3 text-right esh-button-actions">
                <a href="~/" class="btn esh-button esh-button-secondary">[ Cancel ]</a>
                <button type="submit" class="btn esh-button esh-button-primary">[ Create ]</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
