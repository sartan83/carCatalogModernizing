<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Antlr" Version="3.5.0.2" />
    <PackageVersion Include="AspNet.ScriptManager.bootstrap" Version="4.3.1" />
    <PackageVersion Include="AspNet.ScriptManager.jQuery" Version="3.3.1" />
    <PackageVersion Include="Autofac" Version="6.1.0" />
    <PackageVersion Include="Autofac.Mvc5" Version="6.0.0" />
    <PackageVersion Include="Autofac.Web" Version="6.0.0" />
    <PackageVersion Include="Autofac.WebApi2" Version="6.0.1" />
    <PackageVersion Include="bootstrap" Version="4.3.1" />
    <PackageVersion Include="EntityFramework" Version="6.2.0" />
    <PackageVersion Include="jQuery" Version="3.5.0" />
    <PackageVersion Include="jQuery.Validation" Version="1.19.4" />
    <PackageVersion Include="log4net" Version="2.0.10" />
    <PackageVersion Include="Microsoft.ApplicationInsights" Version="2.9.1" />
    <PackageVersion Include="Microsoft.ApplicationInsights.Agent.Intercept" Version="2.4.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.DependencyCollector" Version="2.9.1" />
    <PackageVersion Include="Microsoft.ApplicationInsights.PerfCounterCollector" Version="2.9.1" />
    <PackageVersion Include="Microsoft.ApplicationInsights.Web" Version="2.9.1" />
    <PackageVersion Include="Microsoft.ApplicationInsights.WindowsServer" Version="2.9.1" />
    <PackageVersion Include="Microsoft.ApplicationInsights.WindowsServer.TelemetryChannel" Version="2.9.1" />
    <PackageVersion Include="Microsoft.AspNet.FriendlyUrls" Version="1.0.2" />
    <PackageVersion Include="Microsoft.AspNet.FriendlyUrls.Core" Version="1.0.2" />
    <PackageVersion Include="Microsoft.AspNet.Mvc" Version="5.2.7" />
    <PackageVersion Include="Microsoft.AspNet.Razor" Version="3.2.7" />
    <PackageVersion Include="Microsoft.AspNet.ScriptManager.MSAjax" Version="5.0.0" />
    <PackageVersion Include="Microsoft.AspNet.ScriptManager.WebForms" Version="5.0.0" />
    <PackageVersion Include="Microsoft.AspNet.SessionState.SessionStateModule" Version="1.1.0" />
    <PackageVersion Include="Microsoft.AspNet.TelemetryCorrelation" Version="1.0.5" />
    <PackageVersion Include="Microsoft.AspNet.Web.Optimization" Version="1.1.3" />
    <PackageVersion Include="Microsoft.AspNet.Web.Optimization.WebForms" Version="1.1.3" />
    <PackageVersion Include="Microsoft.AspNet.WebApi" Version="5.2.7" />
    <PackageVersion Include="Microsoft.AspNet.WebApi.Client" Version="5.2.7" />
    <PackageVersion Include="Microsoft.AspNet.WebApi.Core" Version="5.2.7" />
    <PackageVersion Include="Microsoft.AspNet.WebApi.WebHost" Version="5.2.7" />
    <PackageVersion Include="Microsoft.AspNet.WebPages" Version="3.2.7" />
    <PackageVersion Include="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" Version="2.0.1" />
    <PackageVersion Include="Microsoft.jQuery.Unobtrusive.Validation" Version="3.2.11" />
    <PackageVersion Include="Microsoft.Net.Compilers" Version="2.10.0" />
    <PackageVersion Include="Microsoft.Web.Infrastructure" Version="1.0.0" />
    <PackageVersion Include="Modernizr" Version="2.8.3" />
    <PackageVersion Include="Newtonsoft.Json" Version="12.0.1" />
    <PackageVersion Include="Pipelines.Sockets.Unofficial" Version="1.0.7" />
    <PackageVersion Include="popper.js" Version="1.14.3" />
    <PackageVersion Include="Respond" Version="1.4.2" />
    <PackageVersion Include="System.Buffers" Version="4.4.0" />
    <!-- The BCL shim packages below stay at the versions the apps shipped with. Autofac 6.1.0
         asks for higher transitive lower bounds (DiagnosticSource >= 4.7.1, which in turn wants
         System.Memory >= 4.5.4, ...), but raising them cascades into new assembly versions and
         binding redirects in the web apps, i.e. a runtime change this phase must not make.
         The resulting NU1605 downgrade warnings match the pre-conversion behavior. -->
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="4.5.1" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="4.5.0" />
    <PackageVersion Include="System.IO.Compression" Version="4.3.0" />
    <PackageVersion Include="System.IO.Compression.ZipFile" Version="4.3.0" />
    <PackageVersion Include="System.IO.Pipelines" Version="4.5.1" />
    <PackageVersion Include="System.Memory" Version="4.5.1" />
    <PackageVersion Include="System.Net.Http" Version="4.3.4" />
    <PackageVersion Include="System.Numerics.Vectors" Version="4.4.0" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="4.5.0" />
    <PackageVersion Include="System.Threading.Channels" Version="4.5.0" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.5.1" />
    <PackageVersion Include="WebGrease" Version="1.6.0" />
  </ItemGroup>

  <!-- Targeting-pack reference assemblies, added per TargetFrameworkVersion in Directory.Build.targets -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net461" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net47" Version="1.0.3" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" />
  </ItemGroup>

  <!-- .NET 8 stack under modern/ -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <!-- Test-only packages -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.6.3" />
    <PackageVersion Include="xunit" Version="2.4.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.4.5" />
  </ItemGroup>

</Project>
