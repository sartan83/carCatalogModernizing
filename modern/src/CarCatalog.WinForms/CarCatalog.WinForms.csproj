<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>CarCatalog.WinForms</AssemblyName>
    <!-- The designer-generated code and the ported views come from the legacy project unannotated. -->
    <Nullable>disable</Nullable>
    <!-- CS0169: the legacy designer file declares columns it never wires up. -->
    <NoWarn>$(NoWarn);CS0169</NoWarn>
    <!-- Lets the Linux CI job compile (but not run) the Windows-only client. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>CarCatalogWinForms</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="System.ServiceModel.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CarCatalog.ServiceContracts\CarCatalog.ServiceContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
